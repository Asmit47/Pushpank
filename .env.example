# Public Sanity project. The storefront keeps the built-in catalogue until these are set.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only. Read token is needed when the dataset is private.
# Write token is used only by `npm run seed:sanity`.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Google service account JSON on one line. Share the spreadsheet with the service account email.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Shop notification email (Resend). A failed send does not cancel the order.
RESEND_API_KEY=
EMAIL_FROM=
SHOP_NOTIFY_EMAIL=
